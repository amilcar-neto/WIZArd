# Opcional: nenhuma chave de API necessária.
WIZARD_PROVIDER=auto
WIZARD_TIMEOUT_MS=900000
FORMATADOR_PATH="Arquivo Formato Resumo de Sessão.md"
WIZARD_HISTORY_PATH=dados/Transcricoes_Completas_Sessoes.md

# Discord: preencha apenas no .env local.
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
WIZARD_SUMMARY_DIR=dados/resumos

# Transcrição local na VPS (sem API paga). Instale scripts/requirements.txt em um venv.
WIZARD_PYTHON=python3
WIZARD_WHISPER_MODEL=small
WIZARD_TRANSCRIBE_THREADS=2
WIZARD_TRANSCRIBE_TIMEOUT_MS=21600000
# Prazo de guarda do áudio e das transcrições: dias_guarda em config/ajustes.txt.
WIZARD_MAX_RECORDING_HOURS=6
FFMPEG_PATH=ffmpeg

# Deploy (npm run deploy): usuario@endereco da VPS. Fica só no .env local.
WIZARD_DEPLOY_HOST=
