{
  "name": "wizard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "resumir": "node --env-file-if-exists=.env src/cli/summarize.ts",
    "historico": "node --env-file-if-exists=.env src/cli/history.ts",
    "test": "node --test tests/*.test.ts",
    "bot": "node --env-file-if-exists=.env src/discord/bot.ts",
    "enviar": "node --env-file-if-exists=.env src/cli/enqueue.ts",
    "setup:voice": "npm install --prefix voice-runtime --ignore-scripts",
    "check": "node --test tests/delivery.test.ts tests/library.test.ts tests/controls.test.ts tests/jobs.test.ts tests/campaign.test.ts tests/resumidor.test.ts",
    "deploy": "node --env-file-if-exists=.env deploy/publish.ts"
  },
  "dependencies": {
    "discord.js": "14.27.0"
  }
}
